# Copy to .env.local and fill in. Never commit .env.local.

# SERV Reasoning (console.openserv.ai > API Keys)
SERV_API_KEY=
SERV_MODEL=gpt-5.4-mini

# Coinbase Developer Platform (portal.cdp.coinbase.com > API Keys, and > Server Wallet > Wallet Secret)
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=

# Postgres (neon.tech > project > connection string)
DATABASE_URL=

# Filled in by the build (leave blank)
DEPLOYER_PRIVATE_KEY=
HALO_POOL_ADDRESS=
